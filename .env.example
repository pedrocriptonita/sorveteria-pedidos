# ──────────────────────────────────────────────────────────────
# App
# ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
WHATSAPP_SUPPORT_NUMBER="55XXXXXXXXXXX"   # canal de suporte ao cliente

# ──────────────────────────────────────────────────────────────
# Banco de dados (Supabase Postgres) — usado por Prisma
#   DATABASE_URL: conexão com pooling (pgbouncer) p/ runtime
#   DIRECT_URL:   conexão direta p/ migrations
# ──────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres"

# ──────────────────────────────────────────────────────────────
# Supabase (Auth + Storage) — Fase 2
# ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""              # somente no servidor — nunca expor no client

# ──────────────────────────────────────────────────────────────
# PSP de PIX (Efí/Gerencianet, Asaas, Mercado Pago, Banco Inter) — Fase 3
# ──────────────────────────────────────────────────────────────
PSP_PROVIDER="asaas"                      # asaas | efi | mercadopago | inter
PSP_BASE_URL=""                           # URL base da API (sandbox no início)
PSP_CLIENT_ID=""
PSP_CLIENT_SECRET=""
PSP_PIX_KEY=""                            # chave PIX recebedora da loja
PSP_WEBHOOK_SECRET=""                     # segredo p/ validar a assinatura do webhook
PIX_EXPIRACAO_SEGUNDOS="900"              # expiração da cobrança (~15 min)

# ──────────────────────────────────────────────────────────────
# Impressão na cozinha — Fase 3
#   PRINT_MODE=agent  → agente local ESC/POS (Opção A)
#   PRINT_MODE=cloud  → impressora cloud-print: Star CloudPRNT / Epson (Opção B)
# ──────────────────────────────────────────────────────────────
PRINT_MODE="agent"
PRINT_AGENT_TOKEN=""                      # token de autenticação do agente local
CLOUDPRNT_TOKEN=""                        # token do endpoint cloud-print (Opção B)
