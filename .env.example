# ──────────────────────────────────────────────────────────────
# App
# ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"   # URL pública (produção: https://seu-dominio)

# ──────────────────────────────────────────────────────────────
# Banco de dados (Supabase Postgres) — usado por Prisma
#   DATABASE_URL: conexão com pooling (pgbouncer) p/ runtime (porta 6543)
#   DIRECT_URL:   conexão direta p/ db:push / migrations (porta 5432)
# ──────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres"

# ──────────────────────────────────────────────────────────────
# Supabase (Auth + Storage)
# ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""              # somente no servidor — nunca expor no client

# ──────────────────────────────────────────────────────────────
# PSP de PIX (Asaas) — cobrança PIX
# ──────────────────────────────────────────────────────────────
PSP_PROVIDER="asaas"
PSP_BASE_URL="https://api-sandbox.asaas.com/v3"   # produção: https://api.asaas.com/v3
PSP_API_KEY=""                            # API Key do Asaas (enviada no header access_token)
PSP_CPF_CNPJ=""                           # CPF/CNPJ da LOJA (o cliente não digita)
PSP_WEBHOOK_SECRET=""                     # token p/ validar o webhook (header asaas-access-token)
PIX_EXPIRACAO_SEGUNDOS="900"              # expiração da cobrança (~15 min)

# ──────────────────────────────────────────────────────────────
# Impressão na cozinha (agente local ESC/POS)
# ──────────────────────────────────────────────────────────────
PRINT_MODE="agent"
PRINT_AGENT_TOKEN=""                      # token de autenticação do agente local

# ──────────────────────────────────────────────────────────────
# WhatsApp bot (Z-API) — opcional (saudação automática ao cliente)
# ──────────────────────────────────────────────────────────────
ZAPI_BASE_URL="https://api.z-api.io"
ZAPI_INSTANCE_ID=""
ZAPI_TOKEN=""
ZAPI_CLIENT_TOKEN=""
ZAPI_WEBHOOK_SECRET=""                     # segredo p/ validar o webhook do Z-API
